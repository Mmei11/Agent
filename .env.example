# 复制为 .env 后，在本机填写 Key；不要提交 .env。
USE_MODEL=0
DASHSCOPE_API_KEY=
# DASHSCOPE_MODEL=qwen-plus
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 可选：每 1000 token 的单价，填了评测报告才会算成本；留空则只统计 token。
# 数值单位与你的账单一致（人民币就填人民币），按服务商当前价目表填写。
# MODEL_PRICE_INPUT_PER_1K=
# MODEL_PRICE_OUTPUT_PER_1K=

# judge 判分模型：可以比业务模型更强、更贵，单独计价。
# JUDGE_MODEL=qwen-max
# JUDGE_PRICE_INPUT_PER_1K=
# JUDGE_PRICE_OUTPUT_PER_1K=

# Phase 4：向量化。复用上面的 DASHSCOPE_API_KEY 与 BASE_URL。
# mock = 本地确定性伪向量，只用来跑通链路，recall 无意义；真实检索填 dashscope。
EMBEDDING_PROVIDER=dashscope
# DASHSCOPE_EMBEDDING_MODEL=text-embedding-v3
# 仅 mock 模式使用；真实模式下维度以模型返回为准。
# EMBEDDING_DIMENSION=1024
# EMBEDDING_BATCH_SIZE=10
# 每 1000 输入 token 单价，留空则只统计 token 不算成本。
# EMBEDDING_PRICE_PER_1K=

# Phase 4：知识库向量库。随主栈一起启停：docker compose up -d knowledge-db
# 本机直接跑 uvicorn 时用默认地址；容器内由 compose 注入 knowledge-db:5432。
# KNOWLEDGE_DB_URL=postgresql://postgres:postgres@127.0.0.1:15433/knowledge

# Phase 2：本地轨迹与可选 Langfuse。
# none = 关闭；jsonl = 落本地文件；langfuse = 送 Langfuse；可组合：jsonl,langfuse
TRACE_SINK=none
# TRACE_PATH=logs/traces.jsonl

# 启动 docker-compose.observability.yml 后启用；密钥由 compose 首次启动时创建。
# 注意用 127.0.0.1，不要用 localhost：本机 localhost 会走 IPv6，Docker 端口映射会返回 502。
# LANGFUSE_PUBLIC_KEY=pk-lf-local
# LANGFUSE_SECRET_KEY=sk-lf-local
# LANGFUSE_HOST=http://127.0.0.1:3000
# Docker 后端用 host.docker.internal 访问宿主机 Langfuse：
# TRACE_SINK_DOCKER=langfuse
# LANGFUSE_HOST_DOCKER=http://host.docker.internal:3000

# Phase 5：分层安全。
# 策略配置与审计文件都可以覆盖默认路径。
# SAFETY_POLICY_PATH=backend/app/safety/policies/safety-policy.json
# AUDIT_LOG_PATH=logs/audit.jsonl

# Phase 6：图执行的线程池大小，等于"同时在跑的问诊轮次"上限。
# 不填时按模式取默认：mock 8（CPU 密集），模型 64（大部分时间等网络）。
# 模型模式下按 provider 配额调整。
# GRAPH_MAX_WORKERS=64

# Phase 6 L3：鉴权。off = 本地/公开演示放行；required = 必须带 X-API-Key。
# 浏览器前端不携带 key；required 用于 curl、评测脚本等机器客户端。
# API_KEYS 逗号分隔，支持轮换；日志与审计只记短哈希。
# AUTH_MODE=off
# API_KEYS=key1,key2

# Phase 6 L3.2：令牌桶限流。三个维度：全局 → 调用方 → 会话。
# 速率按分钟配置；突发容量决定短时间能连发多少。
# RATE_LIMIT_ENABLED=1
# RATE_LIMIT_PER_MINUTE=60
# RATE_BURST=10
# SESSION_RATE_LIMIT_PER_MINUTE=30
# SESSION_BURST=5
# GLOBAL_RATE_LIMIT_PER_MINUTE=600
# GLOBAL_BURST=100

# Phase 6 L3.3：资源边界。
# 请求体超过 32KB -> 413；单条消息超过 2000 字 -> 422；
# 每个调用方同时打开的 SSE 流数量上限 -> 超出 429。
# MAX_BODY_BYTES=32768
# MAX_MESSAGE_CHARS=2000
# MAX_STREAMS_PER_CLIENT=5

# Phase 6 L4：用户反馈。反馈存进 CONSULTATION_DB_PATH 的 feedback 表；
# 评分优先送 Langfuse，未配置时落本地 JSONL。
# SCORE_LOG_PATH=logs/scores.jsonl

# Docker Compose：前端在宿主机上的端口，默认 8081。
# 若本机 8081 已被占用，改成其他空闲端口，例如 8082。
# FRONTEND_PORT=8081

# Docker 后端是否使用真实模型。1 = qwen-plus，会产生费用。
# 只影响容器，不影响本机 pytest / uvicorn 的 USE_MODEL。
# USE_MODEL_DOCKER=0

# Phase B：长会话滚动摘要。0 = 关闭；默认开启，仅在 USE_MODEL=1 时触发。
# SUMMARY_ENABLED=1

# Phase C：MCP 外部工具（默认关闭）。
# 每个 server 必须显式列出 allowed_tools；空列表等于全部拒绝。
# 外部工具一律按 read_only + external 注册，write / sensitive 不接入。
# MCP_ENABLED=0
# MCP_SERVERS=[{"name":"knowledge","transport":"stdio","command":"python","args":["-m","backend.app.tools.mcp_server"],"allowed_tools":["department_route"]}]
# HTTP 方式：先启动 python -m backend.app.tools.mcp_server --http --port 8765
# MCP_SERVERS=[{"name":"knowledge-http","transport":"http","url":"http://127.0.0.1:8765/mcp","allowed_tools":["department_route"]}]
#
# 外部公开工具示例（托管 HTTP，无需 Node；仅作演示，生产建议自托管）：
# MCP_SERVERS=[{"name":"openfda","transport":"http","url":"https://openfda.caseyjhand.com/mcp","allowed_tools":["openfda_get_drug_label","openfda_search_recalls","openfda_search_drug_shortages","openfda_search_drug_approvals","openfda_search_adverse_events"]},{"name":"clinicaltrials","transport":"http","url":"https://clinicaltrials.caseyjhand.com/mcp","allowed_tools":["clinicaltrials_search_studies","clinicaltrials_get_study_record"]},{"name":"pubmed","transport":"http","url":"https://pubmed.caseyjhand.com/mcp","allowed_tools":["pubmed_search_articles","pubmed_fetch_articles"]},{"name":"medlineplus","transport":"http","url":"https://gateway.pipeworx.io/medlineplus/mcp","allowed_tools":["medlineplus_search"]}]
# 自托管 npx 版本需要 Node.js >= 24（cyanheads 系列）；参数名和摘要逻辑可能随版本变化。
#
# Phase D：技能层。SKILLS_ENABLED=0 时只保留 default 技能，完全回退现有行为。
# SKILLS_ENABLED=1
# SKILLS_DIR=skills
# 技能路由：rule（只用关键词）/ model（只问模型）/ hybrid（规则优先，模型兜底）
# SKILL_ROUTER_MODE=hybrid
# 版本化 prompt 目录；默认仓库根目录 prompts/
# PROMPTS_DIR=prompts
# Phase F：隐私与数据保留。默认保留 90 天；生产建议把同意设为强制。
# DATA_RETENTION_DAYS=90
# PRIVACY_CONSENT_REQUIRED=1
# 账号邮件：console 只写后端日志，便于本地演示；生产配置 SMTP。
# EMAIL_BACKEND=console
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=no-reply@example.com
# SMTP_STARTTLS=1

# Docker 后端访问模型时的代理。宿主机代理若使用 fake-ip（DNS 返回 198.18.x.x），
# 容器直连会 TLS 握手失败；此时填宿主机代理地址即可。
# macOS 上用 host.docker.internal，端口换成你的代理端口。
# HTTP_PROXY_DOCKER=http://host.docker.internal:12451
# HTTPS_PROXY_DOCKER=http://host.docker.internal:12451
# NO_PROXY_DOCKER=localhost,127.0.0.1,knowledge-db,host.docker.internal
