# 复制为 .env 后，在本机填写 Key；不要提交 .env。
USE_MODEL=0
DASHSCOPE_API_KEY=
# DASHSCOPE_MODEL=qwen-plus
# DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 可选：每 1000 token 的单价，填了评测报告才会算成本；留空则只统计 token。
# 数值单位与你的账单一致（人民币就填人民币），按服务商当前价目表填写。
# MODEL_PRICE_INPUT_PER_1K=
# MODEL_PRICE_OUTPUT_PER_1K=

# Phase 2：本地轨迹与可选 Langfuse。
# none = 关闭；jsonl = 落本地文件；langfuse = 送 Langfuse；可组合：jsonl,langfuse
TRACE_SINK=none
# TRACE_PATH=logs/traces.jsonl

# 启动 docker-compose.observability.yml 后启用；密钥由 compose 首次启动时创建。
# 注意用 127.0.0.1，不要用 localhost：本机 localhost 会走 IPv6，Docker 端口映射会返回 502。
# LANGFUSE_PUBLIC_KEY=pk-lf-local
# LANGFUSE_SECRET_KEY=sk-lf-local
# LANGFUSE_HOST=http://127.0.0.1:3000
